<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="NaturalLib\**" />
    <EmbeddedResource Remove="NaturalLib\**" />
    <None Remove="NaturalLib\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="NaturalLib\src\Natural\Natural.csproj" />
    <ProjectReference Include="NaturalLib\Natural_Playground\Natural_Playground.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

</Project>
